<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    tools:context=".calculoNomina"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo_nomina"
        android:textAlignment="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nombre_trabajador_nom"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/txtNomExamen2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_evaristo"
        android:inputType="textPersonName"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <ImageView
        android:id="@+id/imgLogoEmpresa"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@mipmap/logo_empresa"
        android:layout_marginBottom="40dp"
        android:contentDescription="Logo Empresa"/>

    <Button
        android:id="@+id/btnEntrarExamen2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_entrar_nom"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnSalirExamen2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_salir_nom"/>
</LinearLayout>
